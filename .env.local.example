# Anthropic — required for Fable 5 enrichment, search, and chat
ANTHROPIC_API_KEY=

# YouTube Data API v3 — required for live video fetching
# Get a key at https://console.cloud.google.com/
YOUTUBE_API_KEY=
# Your channel ID (found in YouTube Studio > Settings > Channel > Advanced settings)
YOUTUBE_CHANNEL_ID=

# Resend — already used for contact form
RESEND_API_KEY=
# Resend Audience ID for newsletter signups (create one at https://resend.com/audiences)
RESEND_AUDIENCE_ID=

# Cloudflare Turnstile — already used for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Internal secret to protect the /api/enrich endpoint
# Set to any long random string, e.g.: openssl rand -hex 32
ENRICH_SECRET=

# Optional: Vercel KV (for persisting enrichments in production)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
