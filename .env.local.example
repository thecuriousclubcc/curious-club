# ---------------------------------------------------------------------------
# Copy to .env.local (gitignored) for local dev. The same variables must exist
# in Vercel > Project Settings > Environment Variables for production.
# Verified against the code on 2026-09-15 — see docs/ACCESS.md for who owns
# each account and how to re-issue a key.
# ---------------------------------------------------------------------------

# --- Required at runtime (site breaks without these) -----------------------

# Groq — chat, /brain AI answers, search, and episode enrichment.
# Used by: app/api/{chat,search,enrich,brain/ask}, scripts/{episode-enricher,x-syndicate}
GROQ_API_KEY=

# Supabase (cc-brain project) — transcript search behind /brain and chat
# grounding. Anon key only; RLS is enforced server-side.
# Used by: app/api/{brain,brain/ask,chat}
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend — contact form delivery and newsletter signups.
# Used by: app/api/{contact,newsletter}
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Cloudflare Turnstile — bot protection on the contact form.
# Used by: app/api/contact, components/contact/ContactForm.tsx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret guarding the /api/enrich endpoint.
# Generate with: openssl rand -hex 32
ENRICH_SECRET=

# --- Optional (sensible fallbacks exist) -----------------------------------

# YouTube channel ID. Falls back to the hardcoded default in lib/videos.ts.
YOUTUBE_CHANNEL_ID=UCtMsMejHNPL_PGVv_iJ2xNw
# YouTube Data API v3 key — adds view counts and durations. Without it the
# catalog falls back to the public RSS feed (no key needed, no view counts).
YOUTUBE_API_KEY=
# Override the Groq model (default: llama-3.3-70b-versatile).
GROQ_MODEL=
# Vercel KV — persists enrichments in production. Without it, lib/enrichment.ts
# falls back to the filesystem cache under public/data/enrichments.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Offline scripts only (never set in Vercel) ----------------------------

# X (Twitter) credentials for `npm run x:post`. Read+Write app permissions.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Target for scripts/enrich-all.ts (default: http://localhost:3000).
BASE_URL=
